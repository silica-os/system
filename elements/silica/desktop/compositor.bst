kind: manual
description: |
  Silica's Wayland compositor (silica-os/compositor): silica-compositor,
  silica-cli and silica-action. silica-test-client goes to the "tests"
  domain, which the system image leaves out (compositor-system.bst); the
  test extension carries it. Update with tools/update-compositor.

build-depends:
- freedesktop-sdk.bst:public-stacks/buildsystem-rust.bst
- freedesktop-sdk.bst:components/pkg-config.bst

depends:
- freedesktop-sdk.bst:public-stacks/runtime-gnu.bst
- freedesktop-sdk.bst:components/systemd.bst
- freedesktop-sdk.bst:components/libinput.bst
- freedesktop-sdk.bst:components/libseat.bst
- freedesktop-sdk.bst:components/libxkbcommon.bst
- freedesktop-sdk.bst:components/pixman.bst
- freedesktop-sdk.bst:components/libglvnd.bst
- freedesktop-sdk.bst:vm/mesa-default.bst

environment:
  CARGO_HOME: '%{build-root}/.cargo'
  # libgbm lives with Mesa, in the GL extension directory.
  RUSTFLAGS: '-L %{libdir}/GL/default/lib'

variables:
  strip-binaries: ''

config:
  build-commands:
  - cargo build --offline --locked --release -p compositor -p silica-cli -p silica-test-client

  install-commands:
  - install -Dm755 -t '%{install-root}%{bindir}' target/release/silica-compositor target/release/silica-cli target/release/silica-action
  - install -Dm755 -t '%{install-root}%{libexecdir}/silica/tests' target/release/silica-test-client

public:
  bst:
    split-rules:
      tests:
      - '%{libexecdir}/silica/tests'
      - '%{libexecdir}/silica/tests/**'

