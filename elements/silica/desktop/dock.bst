kind: manual
description: |
  Silica's Dock (silica-os/dock): silica-dock, the shelf of apps, folders and
  the Trash, as a process of its own on AppKit (linked in as a Rust crate from
  silica-os/appkit's main). The session starts it as the user service
  silica-dock.service. Update with tools/update-cargo dock.

build-depends:
- freedesktop-sdk.bst:public-stacks/buildsystem-rust.bst
- freedesktop-sdk.bst:components/pkg-config.bst

depends:
- freedesktop-sdk.bst:public-stacks/runtime-gnu.bst
- freedesktop-sdk.bst:components/libxkbcommon.bst
- freedesktop-sdk.bst:components/fontconfig.bst

environment:
  CARGO_HOME: '%{build-root}/.cargo'

variables:
  strip-binaries: ''

config:
  build-commands:
  - cargo build --offline --locked --release -p silica-dock

  install-commands:
  - install -Dm755 -t '%{install-root}%{bindir}' target/release/silica-dock

sources:
- kind: git_repo
  url: github:silica-os/dock.git
  track: main
  ref: ed152d1d4640adc2fd0618c8aa78b55edcbdd992
- kind: cargo2
  cargo-lock: Cargo.lock
  git-mirrors:
    https://github.com/: "github:"
