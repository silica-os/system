diff --git a/security/ipe/eval.c b/security/ipe/eval.c
index 4a7be96..0d03417 100644
--- a/security/ipe/eval.c
+++ b/security/ipe/eval.c
@@ -281,6 +281,23 @@ static bool evaluate_fsv_sig_true(const struct ipe_eval_ctx *const ctx)
  * * %true	- The current @ctx match the @p
  * * %false	- The current @ctx doesn't match the @p
  */
+/**
+ * evaluate_anon_mem() - Evaluate @ctx against an anonymous memory property.
+ * @ctx: Supplies a pointer to the context being evaluated.
+ *
+ * Executable memory that no file backs (mmap or mprotect with PROT_EXEC on
+ * anonymous memory: JIT compilers) has no integrity property to check. A
+ * policy can leave it to another LSM, such as SELinux's execmem permission.
+ *
+ * Return:
+ * * %true	- The operation maps anonymous memory executable
+ * * %false	- The operation is on a file
+ */
+static bool evaluate_anon_mem(const struct ipe_eval_ctx *const ctx)
+{
+	return !ctx->file && (ctx->hook == IPE_HOOK_MMAP || ctx->hook == IPE_HOOK_MPROTECT);
+}
+
 static bool evaluate_property(const struct ipe_eval_ctx *const ctx,
 			      struct ipe_prop *p)
 {
@@ -301,6 +318,10 @@ static bool evaluate_property(const struct ipe_eval_ctx *const ctx,
 		return evaluate_fsv_sig_false(ctx);
 	case IPE_PROP_FSV_SIG_TRUE:
 		return evaluate_fsv_sig_true(ctx);
+	case IPE_PROP_ANON_MEM_FALSE:
+		return !evaluate_anon_mem(ctx);
+	case IPE_PROP_ANON_MEM_TRUE:
+		return evaluate_anon_mem(ctx);
 	default:
 		return false;
 	}
