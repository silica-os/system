enable NetworkManager.service
enable NetworkManager-dispatcher.service
enable iwd.service
enable ModemManager.service
enable bluetooth.service
enable systemd-resolved.service
enable systemd-timesyncd.service
enable systemd-homed.service
enable systemd-homed-activate.service
enable systemd-homed-firstboot.service
enable systemd-userdbd.socket
enable avahi-daemon.service
enable cups.socket
enable upower.service
enable fwupd-refresh.timer
enable silica-boot-bless.service
enable silica-update.timer
disable systemd-networkd.service
disable systemd-networkd.socket
disable systemd-networkd-wait-online.service
enable NetworkManager-wait-online.service
disable systemd-sysupdate.timer
disable systemd-sysupdate-reboot.timer
disable systemd-pcrlock-secureboot-policy.service
disable systemd-pcrlock-firmware-code.service
disable systemd-pcrlock-firmware-config.service
disable systemd-pcrlock-machine-id.service
disable systemd-pcrlock-make-policy.service
disable systemd-pcrlock-file-system.service
disable systemd-pcrlock-secureboot-authority.service
enable silica-ipe.service
