[Unit]
Description=Silica Dock
Documentation=https://github.com/silica-os/dock
# A shell component of the graphical session: it starts when the compositor is ready and
# goes with the session.
PartOf=graphical-session.target
After=graphical-session.target silica-compositor.service
ConditionPathExists=/usr/bin/silica-dock

[Service]
Type=exec
Slice=session.slice
# The compositor shows the shell protocols only to processes that say they are shell
# components (it reads this from the process' environment).
Environment=SILICA_SHELL=1
ExecStart=/usr/bin/silica-dock
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
