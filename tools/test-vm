def client_pixels(path):
    """Counts the pixels of the test client's color (d03030) in a PPM screendump."""
    with open(path, "rb") as f:
        data = f.read()
    m = re.match(rb"P6\s+(\d+)\s+(\d+)\s+(\d+)\s", data)
    if not m:
        return 0, 0
    pixels = data[m.end():]
    total = len(pixels) // 3
    red = sum(1 for i in range(0, len(pixels) - 2, 3)
              if abs(pixels[i] - 0xd0) < 24 and pixels[i + 1] < 0x58 and pixels[i + 2] < 0x58)
    lit = sum(1 for i in range(0, len(pixels) - 2, 3) if pixels[i] | pixels[i + 1] | pixels[i + 2])
    return red, lit / max(total, 1)


def png_to_ppm(png, path):
    """Writes an 8-bit RGB or RGBA PNG (the compositor's screenshot) as a PPM."""
    if png[:8] != b"\x89PNG\r\n\x1a\n":
        return False
    pos, idat, width = 8, b"", 0
    while pos + 8 <= len(png):
        length, kind = struct.unpack(">I4s", png[pos:pos + 8])
        body = png[pos + 8:pos + 8 + length]
        if kind == b"IHDR":
            width, height, depth, color = struct.unpack(">IIBB", body[:10])
            if depth != 8 or color not in (2, 6):
                return False
            bpp = 3 if color == 2 else 4
        elif kind == b"IDAT":
            idat += body
        pos += 12 + length
    if not width:
        return False
    raw, stride = zlib.decompress(idat), width * bpp
    rows, prev = [], bytearray(stride)
    for y in range(height):
        kind, line = raw[y * (stride + 1)], bytearray(raw[y * (stride + 1) + 1:(y + 1) * (stride + 1)])
        for i in range(stride):
            a = line[i - bpp] if i >= bpp else 0
            b, c = prev[i], prev[i - bpp] if i >= bpp else 0
            if kind == 1:
                line[i] = (line[i] + a) & 0xff
            elif kind == 2:
                line[i] = (line[i] + b) & 0xff
            elif kind == 3:
                line[i] = (line[i] + (a + b) // 2) & 0xff
            elif kind == 4:
                pa, pb, pc = abs(b - c), abs(a - c), abs(a + b - 2 * c)
                line[i] = (line[i] + (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 0xff
        rows.append(bytes(line) if bpp == 3 else bytes(v for i, v in enumerate(line) if i % 4 != 3))
        prev = line
    with open(path, "wb") as f:
        f.write(b"P6 %d %d 255\n" % (width, height) + b"".join(rows))
    return True


def compositor_screenshot(vm, path):
    """The compositor's own screenshot, when QEMU has none (a GL scanout with --gpu)."""
    shot = "/run/user/$(id -u tester)/silica-test-shot.png"
    out = vm.debug.output(f"{USER} --wait --pipe silica-cli screenshot {shot} >/dev/null"
                          f" && base64 -w0 {shot}", timeout=180)
    try:
        return png_to_ppm(base64.b64decode(out), path)
    except (ValueError, zlib.error, struct.error):
        return False


def show(vm, what, command):
    """Prints a command's output, for the diagnosis of a failed check."""
    out = vm.debug.output(command)
    print(f"      --- {what}", flush=True)
    for line in out.splitlines():
        print(f"      {line}", flush=True)


def gallery_pixels(path):
    """Counts the near-white pixels (the Kit Gallery's light window) in a PPM screendump."""
    with open(path, "rb") as f:
        data = f.read()
    m = re.match(rb"P6\s+(\d+)\s+(\d+)\s+(\d+)\s", data)
    if not m:
        return 0
    pixels = data[m.end():]
    return sum(1 for i in range(0, len(pixels) - 2, 3) if min(pixels[i:i + 3]) > 0xf0)


def test_desktop(report, vm, sysext, apps, appkit):
    ext = f"{ROOT}/out/extensions"
    names = [sysext, *(["compositor-apps"] if apps else []), *(["appkit-dev"] if appkit else [])]
    for name in names:
        report.must(os.path.exists(f"{ext}/silica-{name}.raw"), f"{ext}/silica-{name}.raw exists")
    server = subprocess.Popen([sys.executable, "-m", "http.server", "8080"], cwd=ext,
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        fetch = " && ".join(
            "curl -fsS --retry 20 --retry-delay 1 --retry-connrefused"
            f" -o /var/lib/extensions/silica-{name}.raw http://10.0.2.2:8080/silica-{name}.raw"
            for name in names)
        merged = " && ".join(f"systemd-sysext status | grep -q silica-{name}" for name in names)
        report.check(vm, "the signed test extensions merge and their code runs",
                     f"mkdir -p /var/lib/extensions && {fetch}"
                     f" && systemd-sysext refresh >/dev/null && {merged}"
                     " && { /usr/libexec/silica/tests/silica-test-client --bogus 2>/dev/null; [ $? = 2 ]; }")
    finally:
        server.terminate()
        server.wait()
    ok = report.check(vm, "tester's session starts on tty2",
                 f"{{ PASSWORD='{PASSWORD}' homectl activate tester 2>/dev/null; homectl inspect tester | grep -q 'State: active'; }}"
                 " && mkdir -p /run/systemd/user/silica-compositor.service.d"
                 " && printf '[Service]\\nExecStart=\\nExecStart=/usr/bin/silica-compositor"
                 " --control %%t/silica/control.sock\\n' >/run/systemd/user/silica-compositor.service.d/test.conf"
                 # No getty on tty2: the session needs that VT for itself.
                 " && systemctl mask -q --runtime getty@tty2.service autovt@tty2.service && systemctl stop getty@tty2.service autovt@tty2.service"
                 " && chvt 2"
                 " && systemd-run -q --unit=silica-test-session -p PAMName=login -p User=tester"
                 " -p TTYPath=/dev/tty2 -p StandardInput=tty -p StandardOutput=journal"
                 " -E XDG_SESSION_TYPE=wayland -E XDG_SESSION_CLASS=user /usr/bin/silica-session"
                 " && sleep 2 && systemctl is-active -q silica-test-session.service")
    for name, command in SESSION_CHECKS:
        ok = report.check(vm, name, command, timeout=180) and ok
    if not ok:
        show(vm, "session journal", "journalctl -b --no-pager -o short-monotonic"
             " _UID=$(id -u tester) + _SYSTEMD_UNIT=silica-test-session.service"
             " | grep -vE ' (AVC|SYSCALL|PROCTITLE|CWD|PATH|EXECVE) ' | tail -n 40 | cut -c1-200")
    shot = vm.screendump(SCREEN) or compositor_screenshot(vm, SCREEN)
    red, lit = client_pixels(SCREEN) if shot else (0, 0)
    report.must(shot, "screendump of the display")
    ok = red > 480 * 320 // 2 and lit > 0.5
    print(f"{'PASS' if ok else 'FAIL'}  the display shows the client's window ({red} red pixels, {lit:.0%} lit)", flush=True)
    if not ok:
        report.failed += 1
    for name, command in VT_CHECKS:
        report.check(vm, name, command, timeout=180)
    for index, (name, command, app_id) in enumerate(APPS if apps else []):
        if not report.check(vm, name, app_check(index, command, app_id), timeout=180):
            show(vm, f"{command} journal", f"journalctl -q --user-unit=silica-test-app{index}.service"
                 f" _UID=$(id -u tester) -o cat | tail -n 15 | cut -c1-400;"
                 f" {USER} --wait --pipe silica-cli window.list | cut -c1-400")
    if appkit:
        gallery = f"{LOGDIR}/silica-test-gallery.ppm"
        mapped = report.check(vm, "the Kit Gallery maps its window",
                              app_check(len(APPS), "/usr/bin/appkit-gallery", "dev.silica.KitGallery"),
                              timeout=180)
        shot = mapped and (vm.screendump(gallery) or compositor_screenshot(vm, gallery))
        white = gallery_pixels(gallery) if shot else 0
        # The 900×800 window is mostly its light background.
        ok = white > 900 * 800 // 2
        print(f"{'PASS' if ok else 'FAIL'}  the Kit Gallery draws its window ({white} light pixels)", flush=True)
        if not ok:
            report.failed += 1
    report.check(vm, "the compositor logged no errors",
                 "! journalctl -q _SYSTEMD_USER_UNIT=silica-compositor.service -p err -o cat | grep .")


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--update", metavar="VERSION")
    parser.add_argument("--install", action="store_true")
    parser.add_argument("--desktop", action="store_true")
    parser.add_argument("--gpu", choices=["virgl", "venus"])
    parser.add_argument("--keep", action="store_true")
    parser.add_argument("--sysext", default="compositor-tests",
                        help="the extension --desktop installs (compositor-dev: a dev build)")
    parser.add_argument("--apps", action="store_true",
                        help="with --desktop: also install compositor-apps and check GTK and Qt apps")
    parser.add_argument("--appkit", action="store_true",
                        help="with --desktop: also install appkit-dev and check the Kit Gallery")
    args = parser.parse_args()

    creds = []
    for c in ("firstboot.locale=en_US.UTF-8", "firstboot.keymap=us", "firstboot.timezone=UTC"):
        creds += ["--credential", c]
    creds += ["--credential-binary", tester_credential()]

    report = Report()
    gpu = ["--gpu", args.gpu] if args.gpu else []
    vm = Vm(["--fresh", *gpu, *(["--target-disk"] if args.install else []), *creds], "boot")
    try:
        boot_and_check(report, vm, BASE_CHECKS)
        if args.desktop:
            test_desktop(report, vm, args.sysext, args.apps, args.appkit)
        if args.update:
            test_update(report, vm, args.update)
        if args.install:
            report.check(vm, "installer writes the second disk",
                         "/usr/libexec/silica/silica-install --yes --disk /dev/$(basename $(readlink -f /dev/disk/by-id/virtio-silica-target))", timeout=1800)
            vm.debug.send("systemctl poweroff")
            vm.proc.wait(300)
    except (RuntimeError, EOFError, OSError) as e:
        print(f"stopped: {e}", flush=True)
        report.failed += 1
    finally:
        vm.stop()

    if args.install and report.failed == 0:
        vm = Vm(["--boot-target", *creds], "installed")
        try:
            boot_and_check(report, vm, BASE_CHECKS)
        except (RuntimeError, EOFError, OSError) as e:
            print(f"stopped: {e}", flush=True)
            report.failed += 1
        finally:
            vm.stop()

    print(f"{report.failed} check(s) failed" if report.failed else "all checks passed")
    if report.failed == 0 and not args.keep:
        subprocess.run(["rm", "-rf", f"{ROOT}/out/vm"], check=False)
    return 1 if report.failed else 0


if __name__ == "__main__":
    sys.exit(main())
