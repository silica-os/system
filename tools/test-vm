#!/usr/bin/env python3
"""Boots a fresh Silica image in QEMU and checks the base system.

  tools/test-vm [--update VERSION] [--install] [--keep]

The first boot gets its answers from credentials (locale, keymap, timezone
and a homed user "tester"), so it needs no screen. The checks run as root in
the debug shell on ttyS1, which works only with Secure Boot off.

--update VERSION  serves out/update-VERSION on port 8080, updates, reboots and
                  checks that VERSION booted and was blessed
                  (build it with tools/build-update VERSION).
--install         installs onto a second disk, then boots that disk alone.
--keep            leaves out/vm and the logs in place after a failure.

Logs go to /dev/shm/silica-test-*. Exits non-zero when a check fails.
"""
import argparse
import base64
import json
import os
import re
import socket
import subprocess
import sys
import threading
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
LOGDIR = "/dev/shm"
SERIAL = f"{LOGDIR}/silica-test-serial.sock"
DEBUG = f"{LOGDIR}/silica-test-debug.sock"
# Strong enough for pwquality, or homectl falls back to asking on the screen.
